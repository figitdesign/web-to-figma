# Visual-parity pipeline (M2+) — Figma credentials for LOCAL development.
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this `.env.example` is committed with placeholders only. The same three
# values later become GitHub Environment (`oracle`) secrets for the scheduled
# job — but nothing here is needed until M2.

# The scratch Figma file's key, taken from its URL:
#   https://www.figma.com/file/<FIGMA_FILE_KEY>/Some-Name
FIGMA_FILE_KEY=aBcd1234EXAMPLEfilekeyXYZ

# Figma REST personal access token, read-only (`file_read` scope).
# Figma → Settings → Security → Personal access tokens. (Real tokens start
# with a short prefix and are long — do not commit yours; it goes in .env.)
FIGMA_TOKEN=REPLACE_WITH_YOUR_FIGMA_READ_TOKEN

# Playwright login session for driving figma.com. NOT copied from Figma —
# it is generated by `cli figma login` (WS-2.1), which opens a browser, waits
# for you to sign in once, and writes the session here. Locally this is a path
# to a gitignored file; in CI it's the JSON (or base64) stored as a secret.
FIGMA_STORAGE_STATE=.figma-storage-state.json
