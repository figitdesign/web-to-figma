# Visual-parity pipeline (M2+) — Figma credentials for LOCAL development.
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this `.env.example` is committed with placeholders only. The whole pipeline
# runs locally, so these values never leave your machine — and nothing here
# is needed until M2.

# The scratch Figma file's key, taken from its URL:
#   https://www.figma.com/file/<FIGMA_FILE_KEY>/Some-Name
FIGMA_FILE_KEY=aBcd1234EXAMPLEfilekeyXYZ

# OPTIONAL — leave blank unless the Tier-2 REST pixel fallback is enabled.
# The pipeline captures both structure (copy-back) and pixels (Copy as PNG)
# through the browser session, so no REST token is needed on the primary path.
# Only set this (read-only, `file_read` scope) if in-browser PNG capture proves
# unreliable and you enable `--pixels=rest`.
FIGMA_TOKEN=

# Playwright login session for driving figma.com. NOT copied from Figma —
# it is generated by `cli figma login` (WS-2.1), which opens a browser, waits
# for you to sign in once, and writes the session here: a path to a
# gitignored file that is a full login. Treat it like a password.
FIGMA_STORAGE_STATE=.figma-storage-state.json
